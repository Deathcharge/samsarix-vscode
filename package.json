{
  "name": "helix-vscode-extension",
  "displayName": "Helix — Local Review-First AI",
  "description": "Ask a local Ollama model about explicit code selections and review one-file edits before applying them.",
  "version": "1.0.0",
  "publisher": "samsara-helix",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ollama",
    "local ai",
    "code review",
    "privacy",
    "diff"
  ],
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Deathcharge/helix-vscode-extension.git"
  },
  "homepage": "https://github.com/Deathcharge/helix-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/Deathcharge/helix-vscode-extension/issues"
  },
  "activationEvents": [
    "onView:helix.chatPanel",
    "onCommand:helix.openChat",
    "onCommand:helix.configureOllama",
    "onCommand:helix.testConnection",
    "onCommand:helix.addSelection",
    "onCommand:helix.runAgentEdit",
    "onCommand:helix.revertLastEdit",
    "onCommand:helix.showPrivacy"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat without workspace context is available. Attaching code and editing files require Workspace Trust.",
      "restrictedConfigurations": [
        "helix.ollama.endpoint",
        "helix.ollama.model",
        "helix.ollama.allowRemoteEndpoint"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "helix.openChat",
        "title": "Open Local Chat",
        "category": "Helix"
      },
      {
        "command": "helix.configureOllama",
        "title": "Configure Ollama",
        "category": "Helix"
      },
      {
        "command": "helix.testConnection",
        "title": "Test Ollama Connection",
        "category": "Helix"
      },
      {
        "command": "helix.addSelection",
        "title": "Add Editor Selection to Local Chat",
        "category": "Helix"
      },
      {
        "command": "helix.runAgentEdit",
        "title": "Propose Edit to Active File…",
        "category": "Helix"
      },
      {
        "command": "helix.revertLastEdit",
        "title": "Revert Last Applied Edit",
        "category": "Helix"
      },
      {
        "command": "helix.showPrivacy",
        "title": "Show Data & Privacy Details",
        "category": "Helix"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "helix-sidebar",
          "title": "Helix",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "helix-sidebar": [
        {
          "type": "webview",
          "id": "helix.chatPanel",
          "name": "Local Assistant"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "helix.configureOllama",
          "when": "view == helix.chatPanel",
          "group": "navigation@1"
        },
        {
          "command": "helix.testConnection",
          "when": "view == helix.chatPanel",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "helix.addSelection",
          "when": "editorHasSelection && isWorkspaceTrusted",
          "group": "helix@1"
        },
        {
          "command": "helix.runAgentEdit",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "helix@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "helix.openChat",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "configuration": {
      "title": "Helix",
      "properties": {
        "helix.ollama.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "scope": "machine",
          "description": "Ollama origin. Loopback HTTP is allowed; remote endpoints require HTTPS and the explicit opt-in below. Helix sends requests only after a user action."
        },
        "helix.ollama.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "scope": "machine",
          "description": "Installed Ollama model used for chat and edit proposals."
        },
        "helix.ollama.allowRemoteEndpoint": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow an HTTPS Ollama endpoint that is not loopback. Enabling this can send prompts and explicitly attached source code across the network."
        },
        "helix.requestTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 120,
          "scope": "machine",
          "description": "Maximum time for an Ollama request before Helix cancels it."
        },
        "helix.maxContextCharacters": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 100000,
          "scope": "machine",
          "description": "Maximum characters in an explicitly attached editor selection."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "npm run clean && tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "tsc --watch -p ./",
    "lint": "eslint src/extension.ts src/local/**/*.ts",
    "test": "jest --coverage",
    "prepackage": "npm run compile",
    "package": "vsce package --out dist/helix-vscode-extension-1.0.0.vsix && node scripts/normalize-vsix.mjs",
    "inspect:package": "node scripts/inspect-package.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run package && npm run inspect:package"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1",
    "yauzl": "^2.10.0",
    "yazl": "^2.5.1"
  }
}
